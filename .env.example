# ============================================
# Database Configuration (MySQL bên ngoài Docker)
# ============================================
# URL kết nối MySQL - sử dụng host.docker.internal để container kết nối đến MySQL trên máy host
# Trên Linux, nếu host.docker.internal không hoạt động, thay bằng IP máy host hoặc 172.17.0.1
SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/class_management?useSSL=false&allowPublicKeyRetrieval=true&tcpKeepAlive=true&autoReconnect=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh

# Username MySQL (thường là root hoặc user bạn đã tạo)
SPRING_DATASOURCE_USERNAME=root

# Password MySQL
SPRING_DATASOURCE_PASSWORD=your-mysql-password

# ============================================
# Email Configuration
# ============================================
# Email dùng để gửi thông báo
EMAIL=your-email@gmail.com

# Password của email (hoặc App Password nếu dùng Gmail)
PASSWORD_EMAIL=your-email-password

# ============================================
# JWT Configuration
# ============================================
# Secret key để mã hóa JWT token (nên thay đổi trong production)
JWT_KEY_SECRET=your-secret-key-change-in-production-min-32-characters

APP_ENV=local
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=bot-token
TELEGRAM_CHAT_ID=chat-id

JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -XX:+UseContainerSupport -Djava.security.egd=file:/dev/./urandom

GROQ_API_KEY=your-groq-api-key

# Optional: override model / base url
GROQ_MODEL=your-groq-model
GROQ_BASE_URL=https://api.groq.com/openai/v1

### Existing app settings (copy from your current be/.env)
DB_HOST=host.docker.internal:3307
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name